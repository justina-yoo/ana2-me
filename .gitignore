# Ignore everything by default
*
.DS_Store

# ── Site files (whitelist) ──

# Root assets
!.gitignore
!index.html
!vite.config.js
!package.json

# Public (static assets served as-is)
!public/
!public/**
public/**/.DS_Store
public/photos/_original_backup/

# Source code
!src/
!src/**

# Netlify edge functions
!netlify/
!netlify/**

# Build output
dist/
